class Bank {
    List<Long> list=new ArrayList<>();
    public Bank(long[] balance) {
        for(int i=0;i<balance.length;i++)
           list.add(balance[i]);
    }
    
    public boolean transfer(int a1, int a2, long money) {
        if(a1>list.size()||a2>list.size()||list.get(a1-1)<money)
            return false;
        list.set(a1-1,list.get(a1-1)-money);
        list.set(a2-1,list.get(a2-1)+money);
        return true;
    }
    
    public boolean deposit(int a, long money) {
        if(a>list.size())
            return false;
        list.set(a-1,money+list.get(a-1));
        return true;
    }
    
    public boolean withdraw(int a, long money) {
        if(a>list.size()||list.get(a-1)<money)
           return false;
        list.set(a-1,list.get(a-1)-money);
        return true;
    }
}

