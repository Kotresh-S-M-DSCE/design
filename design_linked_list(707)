public class ListNode
{
    int val;
    ListNode next;
    ListNode(){}
    ListNode(int val){
        this.val=val;
    }
    ListNode(int val,ListNode next)
    {
        this.val=val;
        this.next=next;
    }
}
class MyLinkedList {

    ListNode head=null;
    public MyLinkedList() {
        
    }
    
    public int get(int index) {
        int count=0;
        ListNode temp=head;
        while(temp!=null)
        {
            if(count==index)
               return temp.val;
            count++;
            temp=temp.next;
        }
        return -1;
    }
    
    public void addAtHead(int val) {
        ListNode node=new ListNode(val);
        node.next=head;
        head=node;
    }
    
    public void addAtTail(int val) {
        ListNode node=new ListNode(val),temp=head;
        if(head==null)
        {
            head=node;
            return;
        }
        while(temp.next!=null)
           temp=temp.next;
        temp.next=node;
    }
    
    public void addAtIndex(int index, int val) {
        int count=0;
        ListNode node=new ListNode(val),temp=head,prev=null;
        if(index==0)
        {
            node.next=head;
            head=node;
            return;
        }
        while(temp!=null)
        {
            if(count==index)
               break;
            count++;
            prev=temp;
            temp=temp.next;
        }
        if(count==index)
        {
            prev.next=node;
            node.next=temp;
        }
    }
    
    public void deleteAtIndex(int index) {
        int count=0;
        ListNode temp=head,prev=head;
        if(head==null)
            return;
        if(index==0)
        {
            head=head.next;
            return;
        }
        while(temp!=null)
        {//71 62 36 38 
            if(count==index)
               break;
            count++;
            prev=temp;
            temp=temp.next;
        }
        if(count==index)
        {
            if(temp!=null)
               prev.next=temp.next;
            else
               prev.next=null;
        }
    }
}

