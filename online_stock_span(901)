class StockSpanner {

    public StockSpanner() {
        
    }
    List<Integer> list=new ArrayList<>();
    public int next(int price) {
        if(list.size()==0||list.get(list.size()-1)>price)
        {
            list.add(price);
            return 1;
        }
        int ret=1,i=list.size()-1;
        while(i>=0&&list.get(i)<=price)
        {
            ret++;
            i--;
        }
        list.add(price);
        return ret;
    }
}

