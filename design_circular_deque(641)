public class ListNode
{
    int val;
    ListNode next;
    ListNode(){}
    ListNode(int val){
        this.val=val;
    }
    ListNode(int val,ListNode next)
    {
        this.val=val;
        this.next=next;
    }
}
class MyCircularDeque {

    int size=0,count=0;
    public MyCircularDeque(int k) {
        size=k;
    }
    
    ListNode head=null,temp=null;
    public boolean insertFront(int value) {
        if(count==size)
            return false;
        count++;
        ListNode node=new ListNode(value);
        if(head==null)
        {
            head=node;
            temp=node;
        }
        else
        {
            node.next=head;
            head=node;
        }
        return true;
    }
    
    public boolean insertLast(int value) {
        if(count==size)
            return false;
        count++;
        ListNode node=new ListNode(value);
        if(head==null)
        {
            head=node;
            temp=node;
        }
        else
        {
            temp.next=node;
            temp=temp.next;
        }
        return true;
    }
    
    public boolean deleteFront() {
        if(count==0)
            return false;
        count--;
        ListNode cur=head;
        head=head.next;
        cur.next=null;
        return true;
    }
    
    public boolean deleteLast() {
        if(count==0)
           return false;
        count--;
        if(head.next==null)
        {
            head=null;
            return true;
        }
        ListNode trav=head,prev=null;
        while(trav.next!=null)
        {
            prev=trav;
            trav=trav.next;
        }
        prev.next=null;
        temp=prev;
        return true;
    }
    
    public int getFront() {
        if(count==0)
           return -1;
        return head.val;
    }
    
    public int getRear() {
        if(count==0)
           return -1;
        return temp.val;
    }
    
    public boolean isEmpty() {
        if(count==0)
           return true;
        return false;
    }
    
    public boolean isFull() {
        if(count==size)
           return true;
        return false;
    }
}

